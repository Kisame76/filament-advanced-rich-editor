{
  "name": "kisame76/filament-advanced-rich-editor",
  "description": "A drop-in Filament v5 RichEditor with a configurable toolbar, a media browser, task lists, a slash menu, video embeds, rendered mentions and Spatie Media Library attachments.",
  "keywords": [
    "filament",
    "filamentphp",
    "laravel",
    "rich-editor",
    "tiptap",
    "wysiwyg",
    "editor",
    "toolbar",
    "media-library",
    "mentions",
    "filament-plugin"
  ],
  "homepage": "https://github.com/Kisame76/filament-advanced-rich-editor",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Kisame76/filament-advanced-rich-editor/issues",
    "source": "https://github.com/Kisame76/filament-advanced-rich-editor"
  },
  "authors": [
    {
      "name": "Kiyan Doguc",
      "email": "k.doguc@kisame-labs.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "filament/actions": "^5.7",
    "filament/forms": "^5.7",
    "filament/schemas": "^5.7",
    "filament/support": "^5.7",
    "illuminate/contracts": "^11.0||^12.0||^13.0",
    "illuminate/database": "^11.0||^12.0||^13.0",
    "illuminate/support": "^11.0||^12.0||^13.0",
    "spatie/laravel-package-tools": "^1.16",
    "ueberdosis/tiptap-php": "^2.0"
  },
  "require-dev": {
    "filament/filament": "^5.7",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "league/html-to-markdown": "^5.1",
    "orchestra/testbench": "^9.0||^10.0||^11.0",
    "pestphp/pest": "^3.0||^4.0",
    "pestphp/pest-plugin-laravel": "^3.0||^4.0",
    "phiki/phiki": "^2.2",
    "spatie/laravel-medialibrary": "^11.0"
  },
  "suggest": {
    "spatie/laravel-medialibrary": "Required to store editor image attachments in a media library collection (^11.0).",
    "league/html-to-markdown": "Required to render stored rich content as Markdown with `AdvancedRichContentRenderer::toMarkdown()` (^5.1).",
    "phiki/phiki": "Required to colour code blocks when rendering stored content with `AdvancedRichContentRenderer::highlightCode()` (^2.2)."
  },
  "autoload": {
    "psr-4": {
      "Kisame76\\FilamentAdvancedRichEditor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kisame76\\FilamentAdvancedRichEditor\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "pint": "vendor/bin/pint",
    "test": "vendor/bin/pest",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
    "build-assets": [
      "cp resources/css/filament-advanced-rich-editor.css resources/dist/filament-advanced-rich-editor.css",
      "cp resources/js/*.js resources/dist/js/"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Kisame76\\FilamentAdvancedRichEditor\\FilamentAdvancedRichEditorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
