{
  "name": "kisame76/filament-advanced-rich-editor",
  "description": "A drop-in Filament v5 RichEditor with a configurable toolbar — dropdowns, dividers, sticky header, task lists and Spatie Media Library attachments.",
  "keywords": [
    "filament",
    "filamentphp",
    "laravel",
    "rich-editor",
    "tiptap",
    "wysiwyg",
    "editor",
    "toolbar"
  ],
  "homepage": "https://github.com/Kisame76/filament-advanced-rich-editor",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/Kisame76/filament-advanced-rich-editor/issues",
    "source": "https://github.com/Kisame76/filament-advanced-rich-editor"
  },
  "authors": [
    {
      "name": "Kiyan Doguc",
      "email": "k.doguc@kisame-labs.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "filament/actions": "^5.0",
    "filament/forms": "^5.0",
    "filament/schemas": "^5.0",
    "filament/support": "^5.0",
    "illuminate/contracts": "^11.0||^12.0||^13.0",
    "illuminate/database": "^11.0||^12.0||^13.0",
    "illuminate/support": "^11.0||^12.0||^13.0",
    "spatie/laravel-package-tools": "^1.16",
    "ueberdosis/tiptap-php": "^2.0"
  },
  "require-dev": {
    "filament/filament": "^5.0",
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^9.0||^10.0||^11.0",
    "pestphp/pest": "^3.0||^4.0",
    "pestphp/pest-plugin-laravel": "^3.0||^4.0",
    "spatie/laravel-medialibrary": "^11.0||^12.0"
  },
  "suggest": {
    "spatie/laravel-medialibrary": "Required to store editor image attachments in a media library collection (^11.0||^12.0)."
  },
  "autoload": {
    "psr-4": {
      "Kisame76\\FilamentAdvancedRichEditor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kisame76\\FilamentAdvancedRichEditor\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "pint": "vendor/bin/pint",
    "test": "vendor/bin/pest",
    "analyse": "vendor/bin/phpstan analyse"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Kisame76\\FilamentAdvancedRichEditor\\FilamentAdvancedRichEditorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
